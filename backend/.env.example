NODE_ENV=development
PORT=4000
HOST=0.0.0.0
# Postgres 14+ recommended. For fast PostGIS-backed rider matching, the database
# needs the `postgis` extension enabled — run `npm run db:postgis` once after
# `prisma db push` (see prisma/postgis-setup.sql). Supported on Render, Railway
# (custom image), Supabase, and RDS with the postgis add-on. If the extension
# is unavailable, the backend automatically falls back to in-memory Haversine
# matching, so this is optional for local dev.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/okadago
# Comma-separated browser origins allowed to call the API (no trailing slashes).
# Include the public web app and the standalone admin app.
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,https://okadago.com,https://www.okadago.com,https://admin.okadago.com
JWT_ISSUER=okadago
JWT_AUDIENCE=okadago-clients
# Optional: public URL for uploaded document links (defaults to http://localhost:PORT)
API_PUBLIC_URL=http://localhost:4000
APP_WEB_URL=http://localhost:3000
PAYSTACK_SECRET_KEY=
PAYSTACK_BASE_URL=https://api.paystack.co
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
MAPBOX_ACCESS_TOKEN=
# Server-side key for Places API (New) with optional legacy Places API fallback.
# Google Cloud: enable billing + "Places API (New)" (required). Optionally enable legacy "Places API".
# Key restrictions: Application = None (server-side). API restrictions = Places API (New) + Places API.
# On Render: add this env var to the backend service and redeploy (not EXPO_PUBLIC_* keys).
GOOGLE_PLACES_API_KEY=
# Optional fallback only if GOOGLE_PLACES_API_KEY is unset — must still be a server key, not Android/iOS Maps SDK keys.
GOOGLE_MAPS_API_KEY=

FIRST_ADMIN_FULL_NAME=
FIRST_ADMIN_EMAIL=
FIRST_ADMIN_PHONE_COUNTRY_CODE=+233
FIRST_ADMIN_PHONE_LOCAL=
FIRST_ADMIN_PHONE_E164=
FIRST_ADMIN_PASSWORD=
FIRST_ADMIN_PREFERRED_CURRENCY=GHS
FIRST_ADMIN_TITLE=
FIRST_ADMIN_PERMISSIONS=users:manage:any,analytics:read:any
GEOCODING_BASE_URL=https://nominatim.openstreetmap.org
GEOCODING_USER_AGENT=OkadaGo/0.1 (http://localhost:3000)
GEOCODING_CONTACT_EMAIL=
# OTP SMS (production). Dev/test still returns debugCode in /auth/otp/request responses.
# Set SMS_PROVIDER=termii|twilio|none. Auto-detects Termii first, then Twilio.
SMS_PROVIDER=
TERMII_API_KEY=
TERMII_SENDER_ID=
TERMII_BASE_URL=https://api.ng.termii.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Cloudinary (profile photo uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
