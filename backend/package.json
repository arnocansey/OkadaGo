{
  "name": "okadago-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "npm run prisma:generate && tsc -p tsconfig.json",
    "start": "tsx src/main.ts",
    "start:prod": "node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --import tsx --test src/**/*.test.ts",
    "admin:bootstrap": "tsx src/scripts/create-first-admin.ts",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:format": "prisma format",
    "prisma:push": "prisma db push",
    "db:postgis": "tsx src/scripts/setup-postgis.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@prisma/adapter-pg": "^7.7.0",
    "cloudinary": "^2.10.0",
    "dotenv": "^17.2.3",
    "fastify": "^5.6.1",
    "socket.io": "^4.8.3",
    "nodemailer": "^7.0.13",
    "pg": "^8.20.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@prisma/client": "^7.8.0",
    "@types/node": "^24.12.2",
    "@types/nodemailer": "^8.0.0",
    "@types/pg": "^8.20.0",
    "prisma": "^7.8.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
