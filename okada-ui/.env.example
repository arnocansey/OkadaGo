NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/v1

# Google Maps JavaScript API key (browser-restricted).
# Enable: Maps JavaScript API, Places API (New), Geocoding API.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Optional: Cloud-based map ID for Advanced Markers (recommended).
# Create at https://console.cloud.google.com/google/maps-apis/studio/maps
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=
