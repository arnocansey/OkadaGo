{
  "expo": {
    "name": "OkadaGo Passenger",
    "slug": "okadago-passenger",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "okadago-passenger",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1A2E4C"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.okadago.passenger",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "OkadaGo uses your location to find nearby drivers and show your pickup point on the map.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "OkadaGo uses your location in the background to keep your trip progress accurate when you switch apps.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.okadago.passenger",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1A2E4C"
      }
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#1A2E4C"
        }
      ],
      "expo-location",
      "expo-localization",
      "expo-notifications",
      "expo-router",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.4"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/icon.png",
      "themeColor": "#1A2E4C",
      "backgroundColor": "#0F172A",
      "shortName": "OkadaGo Passenger",
      "name": "OkadaGo Passenger"
    }
  }
}
