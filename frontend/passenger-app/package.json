{
  "name": "passenger-app",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "eas-build-pre-install": "corepack enable && corepack prepare pnpm@9.15.9 --activate",
    "eas:build:android": "cross-env EAS_NO_VCS=1 eas build --platform android --profile production-apk",
    "eas:build:android:ci": "cross-env EAS_NO_VCS=1 eas build --platform android --profile production-apk --non-interactive",
    "eas:update:production": "npx eas-cli update --channel production",
    "eas:update:preview": "npx eas-cli update --channel preview"
  },
  "dependencies": {
    "@expo/metro-runtime": "~6.1.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@types/react": "~19.1.10",
    "expo": "~54.0.35",
    "expo-build-properties": "~1.0.10",
    "expo-constants": "~18.0.13",
    "expo-device": "~8.0.10",
    "expo-document-picker": "~14.0.8",
    "expo-haptics": "~15.0.8",
    "expo-image-picker": "~17.0.11",
    "expo-linking": "~8.0.12",
    "expo-localization": "^17.0.9",
    "expo-location": "~19.0.8",
    "expo-notifications": "~0.32.16",
    "expo-router": "~6.0.24",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-updates": "~29.0.18",
    "i18next": "^26.3.6",
    "lucide-react-native": "^1.23.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-i18next": "^17.0.10",
    "react-native": "0.81.5",
    "react-native-maps": "1.20.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.0",
    "react-native-webview": "~13.13.5",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "typescript": "~5.9.2"
  }
}
