EXPO_PUBLIC_API_BASE_URL=https://okadago-backend.onrender.com/v1
EXPO_PUBLIC_EAS_PROJECT_ID=94c07182-c892-4106-8b44-3a4ebc25f853
# Required for Expo push token registration via /devices/push-token
EXPO_PUBLIC_GOOGLE_MAPS_ANDROID_API_KEY=your-android-maps-api-key
EXPO_PUBLIC_GOOGLE_MAPS_IOS_API_KEY=your-ios-maps-api-key
# Food & groceries places are loaded via backend /bootstrap/places/* (set GOOGLE_PLACES_API_KEY on backend).
# Client keys below are only needed for react-native-maps tiles, not Places search.
EXPO_PUBLIC_GOOGLE_PLACES_API_KEY=
EXPO_USE_UPDATES=1

# EAS production builds:
# 1. Do NOT put placeholder map keys in eas.json (they override EAS secrets).
# 2. Set secrets on expo.dev for the production environment:
#      eas secret:create --scope project --name EXPO_PUBLIC_GOOGLE_MAPS_ANDROID_API_KEY --value YOUR_KEY --type string
#      eas secret:create --scope project --name EXPO_PUBLIC_GOOGLE_MAPS_IOS_API_KEY --value YOUR_KEY --type string
# 3. Or copy this file to .env with real keys before running eas build (.easignore uploads .env).
# 4. In Google Cloud Console, enable "Maps SDK for Android" on the Android key (separate from Places server key).
# 5. Restrict the Android key to package com.okadago.passenger and add the EAS release SHA-1 fingerprint.
