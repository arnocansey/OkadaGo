EXPO_PUBLIC_API_BASE_URL=https://okadago-backend.onrender.com/v1
EXPO_PUBLIC_EAS_PROJECT_ID=94c07182-c892-4106-8b44-3a4ebc25f853
# Required for Expo push token registration via /devices/push-token
EXPO_PUBLIC_GOOGLE_MAPS_ANDROID_API_KEY=your-android-maps-api-key
EXPO_PUBLIC_GOOGLE_MAPS_IOS_API_KEY=your-ios-maps-api-key
# Food & groceries places are loaded via backend /bootstrap/places/* (set GOOGLE_PLACES_API_KEY on backend).
# Client keys below are only needed for react-native-maps tiles, not Places search.
EXPO_PUBLIC_GOOGLE_PLACES_API_KEY=
EXPO_USE_UPDATES=1
