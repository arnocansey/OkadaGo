{
  "cli": {
    "version": ">= 16.20.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": true
      },
      "env": {
        "EXPO_USE_UPDATES": "1",
        "EXPO_PUBLIC_API_BASE_URL": "https://okadago-backend.onrender.com/v1",
        "EXPO_PUBLIC_GOOGLE_MAPS_IOS_API_KEY": "<will-be-overridden-by-eas-secret>"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "distribution": "internal"
      },
      "env": {
        "EXPO_USE_UPDATES": "1",
        "EXPO_PUBLIC_API_BASE_URL": "https://okadago-backend.onrender.com/v1",
        "EXPO_PUBLIC_GOOGLE_MAPS_IOS_API_KEY": "<will-be-overridden-by-eas-secret>"
      }
    },
    "production": {
      "channel": "production",
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      },
      "ios": {
        "distribution": "internal"
      },
      "env": {
        "EXPO_USE_UPDATES": "1",
        "EXPO_PUBLIC_API_BASE_URL": "https://okadago-backend.onrender.com/v1",
        "EXPO_PUBLIC_GOOGLE_MAPS_IOS_API_KEY": "<will-be-overridden-by-eas-secret>"
      }
    },
    "production-apk": {
      "extends": "production",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_USE_UPDATES": "1",
        "EXPO_PUBLIC_API_BASE_URL": "https://okadago-backend.onrender.com/v1",
        "EXPO_PUBLIC_GOOGLE_MAPS_ANDROID_API_KEY": "<set in .env or EAS secret; .env uploads via .easignore>"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleTeamId": "FILL_FROM_APPLE_DEVELOPER_PORTAL"
      }
    }
  }
}
