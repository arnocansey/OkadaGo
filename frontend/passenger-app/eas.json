{
  "cli": {
    "version": ">= 16.20.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_USE_UPDATES": "1",
        "EXPO_PUBLIC_API_BASE_URL": "https://okadago-backend.onrender.com/v1"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_USE_UPDATES": "1",
        "EXPO_PUBLIC_API_BASE_URL": "https://okadago-backend.onrender.com/v1"
      }
    },
    "production": {
      "channel": "production",
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_USE_UPDATES": "1",
        "EXPO_PUBLIC_API_BASE_URL": "https://okadago-backend.onrender.com/v1"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
