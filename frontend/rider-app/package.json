{
  "name": "rider-app",
  "version": "1.0.0",
  "packageManager": "pnpm@9.15.9",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "eas-build-pre-install": "corepack enable && corepack prepare pnpm@9.15.9 --activate",
    "eas:init": "npx eas-cli init",
    "eas:build:android": "npx eas-cli build --platform android --profile production",
    "eas:build:preview": "npx eas-cli build --platform android --profile preview",
    "eas:update:production": "npx eas-cli update --channel production",
    "eas:update:preview": "npx eas-cli update --channel preview"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^2.2.0",
    "expo": "~54.0.33",
    "expo-haptics": "^56.0.3",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-updates": "^29.0.17",
    "lucide-react-native": "^1.16.0",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "^3.0.0",
    "react-native-reanimated": "^4.4.1",
    "react-native-safe-area-context": "^5.6.2",
    "react-native-svg": "^15.15.5",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "typescript": "~5.9.2"
  },
  "private": true
}
